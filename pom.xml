<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>io.github.alterioncorp</groupId>
		<artifactId>parent-pom</artifactId>
		<version>1.0.4</version>
	</parent>

	<artifactId>logging-filter-parent</artifactId>
	<version>1.1.0</version>
	<packaging>pom</packaging>

	<name>logging-filter-parent</name>
	<description>Parent POM for logging-filter modules</description>
	<url>https://github.com/alterioncorp/logging-filter</url>

	<licenses>
		<license>
			<name>Apache License, Version 2.0</name>
			<url>https://www.apache.org/licenses/LICENSE-2.0</url>
			<distribution>repo</distribution>
		</license>
	</licenses>

	<scm>
		<connection>scm:git:git://github.com/alterioncorp/logging-filter.git</connection>
		<developerConnection>scm:git:ssh://github.com/alterioncorp/logging-filter.git</developerConnection>
		<url>https://github.com/alterioncorp/logging-filter</url>
	</scm>

	<distributionManagement>
		<snapshotRepository>
			<id>github</id>
			<url>https://maven.pkg.github.com/alterioncorp/logging-filter</url>
		</snapshotRepository>
	</distributionManagement>

	<modules>
		<module>logging-filter</module>
		<module>logging-filter-vertx</module>
	</modules>

	<properties>
		<version.slf4j>2.0.17</version.slf4j>
		<version.log4j>2.25.4</version.log4j>
		<version.derby>10.16.1.1</version.derby>
	</properties>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>io.vertx</groupId>
				<artifactId>vertx-core</artifactId>
				<version>4.5.24</version>
			</dependency>
		</dependencies>
	</dependencyManagement>

</project>
